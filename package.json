{
  "name": "@onetodone/cinema-front",
  "version": "1.0.0",
  "description": "Customer web client for the Cinema Booking API — browse movies and showtimes, pick seats on a live seat map, hold them, pay, and see tickets.",
  "private": true,
  "author": "Anton Holubeu (https://github.com/aholu)",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "dotenv -e .env -- sh -c 'next dev -p ${PORT:-3001}'",
    "build": "next build",
    "start": "dotenv -e .env -- sh -c 'next start -p ${PORT:-3001}'",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env -- playwright test",
    "api:types": "openapi-typescript ${CINEMA_API_SPEC:-../cinema-api/api/openapi.yaml} -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.103.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6",
    "vitest": "^5.0.2"
  }
}
